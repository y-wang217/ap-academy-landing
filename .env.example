# Supabase, used only by the /sat trainer (Phase 2 accounts).
#
# Both are safe to expose to the browser: the anon key is the public key and
# every table is protected by row level security. Never put the service_role
# key in a NEXT_PUBLIC_ variable.
#
# Leave these unset and /sat still works: flashcards stay unlimited, the quiz
# keeps its 10-a-day anonymous limit, and sign-in reports that it isn't
# available yet. Set them in Vercel to switch accounts on.
#
# Find both under Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
