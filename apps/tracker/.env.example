# Copy to .env.local for local development. Same two values as apps/landing:
# one Supabase project, one auth pool (ADR 0001). Publishable key only, never a
# secret or service_role key. Unset is supported: the tracker builds and
# renders a "sign-in is not configured" message.
#
# Locally, browse the tracker through landing (http://localhost:3000/tracker,
# with TRACKER_URL=http://localhost:3001 in apps/landing/.env.local) so both
# apps share one origin and one session cookie.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Turns on "Paste from the school portal" (AI drafts, ADR 0026).
# Server-only: never prefix it with NEXT_PUBLIC_. Set a monthly spend limit on
# the key in the Anthropic console. Unset hides the feature.
ANTHROPIC_API_KEY=
